[Unit]
Description=mem-pro Add/Search service (Agent Memory Leaderboard)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mempro
Group=mempro
WorkingDirectory=/opt/mem-pro
# 不要用 EnvironmentFile：systemd 不展开 $VAR，会把 `RERANK_API_KEY=$DASHSCOPE_API_KEY`
# 当成字面量写进环境变量，导致精排 401 后静默降级。交给 service/dotenv.py 读取并展开。
Environment=MALLOC_ARENA_MAX=2
ExecStart=/usr/bin/python3 service/server.py
Restart=always
RestartSec=2
TimeoutStopSec=20
# 退出前最多等 10s，让在途 Add 写完
KillSignal=SIGTERM

# 安全加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/mem-pro/service
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
