# mem-pro 配置模板：复制为 service/.env（或仓库根 .env），已被 .gitignore 忽略
# 也可以直接运行：python3 tools/doctor.py --init

# ---------- Embedding ----------
# hash = 完全离线、确定性，用于开发与契约测试
# api  = 阿里云百炼 text-embedding-v4（正式评测必须）
EMBED_MODE=hash
# EMBED_MODE=api
DASHSCOPE_API_KEY=
EMBED_MODEL=text-embedding-v4
EMBED_DIM=1024
# EMBED_BATCH=10            # 官方单次最多 10 行
# EMBED_CACHE_MAX=20000     # 进程内向量缓存条数
# EMBED_CHUNK_CHARS=3000    # 单段字符上限（中文≈3k token）
# 进程内同时发往 DashScope 的请求上限（按百炼 RPM 配额设置；超了只会换来 429→503→平台退避）
# 上游 HTTP 连接池：keep-alive 复用。每次新建 TCP+TLS 实测单条 embedding 1.3 s，
# 复用后 0.2–0.35 s；池上限按「embedding 并发 + 精排并发」设。
HTTP_POOL_SIZE=32
EMBED_CONCURRENCY=16
EMBED_TIMEOUT=60
# 429 风暴时的总等待上限：到点就 503 + Retry-After，把闸门槽让给健康请求
EMBED_RETRY_BUDGET=12
# 向量化时拼接同一 Add 内前后 N 条消息作上下文（只影响向量，不改返回正文）；0=关闭
EMBED_CONTEXT=0

# ---------- 服务 ----------
HOST=0.0.0.0
PORT=8080
# 相对路径按仓库根解析；Docker 内为 /data/mem.db
DB_PATH=./service/mem.db

# 平台调用你接口时的鉴权 key（生产必填）
# 生成：openssl rand -hex 24
MEMORY_SYSTEM_KEY=

# 同时在途请求上限；超出返回 429 + Retry-After: 1
MAX_INFLIGHT=64
# TCP listen backlog；默认 5 时高并发建连会丢 SYN，p95 飙到秒级
LISTEN_BACKLOG=512
# 单次 Search 最多返回几张图（Answer 预算与 30 MiB 双约束）
MAX_IMAGES=6
LOG_JSON=1
# 启动时真实调用一次 embedding 探活；CI/离线可设 0
STARTUP_CHECK=1

# ---------- 检索 ----------
# 热用户记忆缓存上限（估算字节）；设为 0 可关闭
USER_CACHE_MAX_BYTES=67108864
# 检索索引（BM25 倒排 + 向量矩阵/行）缓存上限，单位 MiB；超限自动退回逐文档计算
RANK_INDEX_MAX_MB=64
DEDUP_COS=0.97
DENSE_WEIGHT=0.95
SPARSE_WEIGHT=0.05
# 时态一致性：tense=问「现在」时压低纯旧事实、问「以前」时抬高；off 关闭
TEMPORAL_RULE=tense
TEMPORAL_WEIGHT=0.06
APPEND_OPTIONS=0

# ---------- 可选：图片描述（开源方法榜只允许 gpt-4o-mini）----------
# none=只用平台随图发送的 caption 文本；openai=对每张图调用 gpt-4o-mini 生成描述并追加到正文
# 结果按 (图片 sha256, 模型, prompt 版本) 落盘缓存，temperature=0 ⇒ 复现时零调用、逐字一致
CAPTION_MODE=none
# OPENAI_API_KEY=
# OPENAI_BASE=https://api.openai.com/v1
# CAPTION_MODEL=gpt-4o-mini
# CAPTION_DETAIL=low
# CAPTION_STRICT=1           # 1=描述失败则 Add 返回 503 让平台重试（保证索引可复现）

# ---------- 可选精排（官方明确 Reranker 不受限）----------
# 精排是旁路：质量明显更好，但每次 Search 多一次往返（实测吞吐 14.1 → 7.7 req/s）。
# 代理榜留出集：MRR 0.761 → 0.808；精排是旁路降级时排序会变，故带重试 + 熔断计数器。
RERANK_MODE=none
# --- 接 DashScope（推荐，无需本地模型；实测单次约 0.4 s）---
# RERANK_MODE=http
# RERANK_KIND=dashscope      # tei | dashscope
# RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
# RERANK_MODEL=gte-rerank-v2
# RERANK_API_KEY=$DASHSCOPE_API_KEY
# --- 接本地 TEI 风格服务（python3 tools/rerank_server.py）---
# RERANK_URL=http://127.0.0.1:8010/rerank
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_TOP=10
# RERANK_TIMEOUT=5            # 精排正常 0.4 s；给 5 s 足够，尾部越短越好
# RERANK_POOL=16              # 精排侧并发上限
# RERANK_RETRIES=2           # 429/5xx/超时/断连的瞬时重试；4xx 直接降级
# RERANK_FAILS=3             # 连续失败几次熔断
# RERANK_COOLDOWN=60         # 熔断冷却秒数

# 精排分容差：gte-rerank-v2 同一请求会在两套精确值间跳（差 ~1.4e-4），
# 容差以内视为并列、改用融合分/时间/ID 排序，保证重放逐位一致。
# RERANK_TOL=0.0003
