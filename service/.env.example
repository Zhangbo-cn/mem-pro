# 复制为 .env 后按需修改；或直接 export 到环境变量
# 本地开发用 hash 模式（不联网、不花钱）
EMBED_MODE=hash
PORT=8080
HOST=0.0.0.0

# 接真实 embedding（学术榜强制 text-embedding-v4）
# EMBED_MODE=api
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
# EMBED_MODEL=text-embedding-v4
# EMBED_DIM=1024

# 生产必须设置：平台调你接口用的鉴权 key（自己生成，勿泄露）
# MEMORY_SYSTEM_KEY=替换为 openssl rand -hex 24 的结果

DB_PATH=./mem.db

# 检索
RECALL_N=50
DEDUP_COS=0.97
APPEND_OPTIONS=0

# 可选精排（Reranker 官方不作限制）
RERANK_MODE=none
# RERANK_MODE=http
# RERANK_URL=http://127.0.0.1:8001/rerank
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_API_KEY=
RERANK_TOP=30
