# mem-pro 配置模板：复制为 service/.env（或仓库根 .env），已被 .gitignore 忽略
# 也可以直接运行：python3 tools/doctor.py --init

# ---------- Embedding ----------
# hash = 完全离线、确定性，用于开发与契约测试
# api  = 阿里云百炼 text-embedding-v4（正式评测必须）
EMBED_MODE=hash
# EMBED_MODE=api
DASHSCOPE_API_KEY=
EMBED_MODEL=text-embedding-v4
EMBED_DIM=1024
# EMBED_BATCH=10            # 官方单次最多 10 行
# EMBED_CACHE_MAX=20000     # 进程内向量缓存条数
# EMBED_CHUNK_CHARS=3000    # 单段字符上限（中文≈3k token）

# ---------- 服务 ----------
HOST=0.0.0.0
PORT=8080
# 相对路径按仓库根解析；Docker 内为 /data/mem.db
DB_PATH=./service/mem.db

# 平台调用你接口时的鉴权 key（生产必填）
# 生成：openssl rand -hex 24
MEMORY_SYSTEM_KEY=

# 同时在途请求上限；超出返回 429 + Retry-After: 1
MAX_INFLIGHT=64
# 单次 Search 最多返回几张图（Answer 预算与 30 MiB 双约束）
MAX_IMAGES=6
LOG_JSON=1
# 启动时真实调用一次 embedding 探活；CI/离线可设 0
STARTUP_CHECK=1

# ---------- 检索 ----------
# 热用户记忆缓存上限（估算字节）；设为 0 可关闭
USER_CACHE_MAX_BYTES=67108864
# 检索索引（BM25 倒排 + 向量矩阵/行）缓存上限，单位 MiB；超限自动退回逐文档计算
RANK_INDEX_MAX_MB=64
DEDUP_COS=0.97
DENSE_WEIGHT=0.95
SPARSE_WEIGHT=0.05
# 时态一致性：tense=问「现在」时压低纯旧事实、问「以前」时抬高；off 关闭
TEMPORAL_RULE=tense
TEMPORAL_WEIGHT=0.06
APPEND_OPTIONS=0

# ---------- 可选精排（官方明确 Reranker 不受限）----------
RERANK_MODE=none
# RERANK_MODE=http
# RERANK_KIND=tei            # tei | dashscope
# RERANK_URL=http://127.0.0.1:8010/rerank
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_API_KEY=
# RERANK_TOP=10
# RERANK_TIMEOUT=8
